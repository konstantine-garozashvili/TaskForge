# ===== TaskForge - Variables d'environnement (racine) =====
# Copier ce fichier en `.env` puis adapter les valeurs.
# Ne JAMAIS committer le fichier `.env` réel.

# --- PostgreSQL (service db du docker-compose) ---
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=taskforge_dev_password
POSTGRES_DB=taskforge
POSTGRES_PORT=5434

# --- Backend ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://taskforge:taskforge_dev_password@localhost:5434/taskforge

# --- JWT (ticket #1) ---
# JWT_SECRET=change-me
# JWT_EXPIRES_IN=1d
