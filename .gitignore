# ===== TaskForge - .gitignore =====

# --- Dependencies ---
node_modules/
.pnp
.pnp.*

# --- Build outputs ---
dist/
build/
out/
.next/
coverage/

# --- Environment variables & secrets ---
.env
.env.*
!.env.example
!.env.sample

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Runtime / caches ---
.cache/
.parcel-cache/
.vite/
.turbo/
*.tsbuildinfo
.npm/
.eslintcache
.stylelintcache

# --- Testing / reports ---
reports/
.nyc_output/

# --- IDE / Editors ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Temp / misc ---
tmp/
temp/
*.local
.vercel
.netlify
.agents/
.claude/
.windsurf/
__pycache__/
