# ===== TaskForge Backend - Environment variables =====
# Copy this file to `.env` and adjust values for your local setup.
# NEVER commit the real `.env` file.

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL dockerisé - docker compose up -d, ticket #17)
DATABASE_URL=postgres://taskforge:taskforge_dev_password@localhost:5434/taskforge

# JWT (ticket #1)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# bcrypt cost factor (default 10)
# BCRYPT_ROUNDS=10
