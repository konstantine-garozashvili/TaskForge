# ===== TaskForge Backend - Environment variables =====
# Copy this file to `.env` and adjust values for your local setup.
# NEVER commit the real `.env` file.

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_URL=http://localhost:5173

# Database (to be configured in Sprint 1 - auth/tickets modules)
# DATABASE_URL=postgres://user:password@localhost:5432/taskforge

# JWT (to be configured in Sprint 1 - issue #1)
# JWT_SECRET=change-me
# JWT_EXPIRES_IN=1d
